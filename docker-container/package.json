{
  "name": "@now-playing/hub",
  "version": "0.1.0",
  "description": "Now Playing Hub \u2014 self-hosted server with password-protected admin GUI on port 4546: providers, group listening, realtime sync, pairing, downloads, metrics, recommendations and a Discord bot.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"tsx watch src/server.ts\" \"vite --config src/web/vite.config.ts\"",
    "dev:api": "tsx src/server.ts",
    "build": "pnpm typecheck && node scripts/build.mjs && vite build --config src/web/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run --project unit --project integration --project security",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "docker:build": "docker build -t now-playing-hub -f Dockerfile ..",
    "docker:up": "docker compose -f compose.yaml up --build"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@node-rs/argon2": "2.2.0",
    "@now-playing/contracts": "workspace:*",
    "@now-playing/domain": "workspace:*",
    "@now-playing/recommendations": "workspace:*",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "fastify": "5.12.1",
    "music-metadata": "11.15.0",
    "opusscript": "0.1.1",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@now-playing/aqua-ui": "workspace:*",
    "@now-playing/test-fixtures": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "happy-dom": "20.14.0",
    "pino-pretty": "13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
