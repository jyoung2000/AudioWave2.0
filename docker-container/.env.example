# Now Playing Hub — environment (copy to .env). Every value has a safe default.

# Where the SQLite database, keys, blobs, downloads, artwork, backups and logs live (the Docker volume).
NP_DATA_DIR=/data
# HTTP/WebSocket port.
NP_PORT=4546
# localhost (default; required for first setup) | lan | remote (behind your own HTTPS reverse proxy / VPN).
# lan/remote only take effect once the bootstrap password has been replaced; the value can also be changed in Admin → Network.
NP_BIND_MODE=localhost
# Optional explicit bind address for lan/remote (e.g. a VPN interface 100.x.y.z). Empty = 0.0.0.0 when not localhost.
NP_BIND_ADDRESS=
# Public base URL used in QR codes, share links and cookies (e.g. https://music.example.com). Empty = unknown.
NP_PUBLIC_ENDPOINT=
# Comma-separated CIDRs whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (your reverse proxy).
NP_TRUSTED_PROXY_CIDRS=
# pino level: trace | debug | info | warn | error
NP_LOG_LEVEL=info
# Optional: inject the Discord bot token from the environment instead of storing it encrypted in the database.
NP_DISCORD_TOKEN=
# Installation key file (32 random bytes, created on first run, mode 0600). Defaults to <NP_DATA_DIR>/keys/install.key.
NP_INSTALL_KEY_FILE=
# How client IPs appear in audit/logs: truncated (default) | hashed (keyed with the install key) | full
NP_IP_LOGGING=truncated
# Optional path to an ffmpeg binary. Empty = look on PATH, then the ffmpeg-static dev dependency.
NP_FFMPEG_PATH=
# Directory served by the built-in public-domain provider (defaults to the generated test fixtures in the workspace).
NP_PUBLIC_DOMAIN_DIR=
# Demo mode (never enable in production): seeds a sample group for screenshots.
NP_DEMO_MODE=false
