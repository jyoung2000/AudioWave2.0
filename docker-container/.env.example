# Copy to `.env` beside compose.yaml. Every value here is optional: the hub starts with none of
# them set, on http://localhost:4546, with admin / admin and a forced password change.

# --- network ------------------------------------------------------------------
# localhost (default) | lan | remote
#   localhost  the hub is reachable only from the machine running it
#   lan        reachable from your local network — also change the port mapping in compose.yaml
#   remote     reachable through a reverse proxy you have configured with TLS
# Any value but localhost stays inactive until the admin password has been changed.
NP_BIND_MODE=localhost

# Absolute URL others use to reach this hub, e.g. https://music.example.com
# Pairing links, share links and OAuth redirects need this; without it they only work locally.
NP_PUBLIC_ENDPOINT=

# CIDRs whose X-Forwarded-For header is trusted, comma separated, e.g. 172.18.0.0/16
# Leave empty unless a reverse proxy you control sits in front of the hub: trusting an untrusted
# proxy lets a caller forge its own IP address in your logs and rate limits.
NP_TRUSTED_PROXY_CIDRS=

# --- privacy ------------------------------------------------------------------
# truncated (default) | hashed | full — how IP addresses appear in logs and the audit trail.
NP_IP_LOGGING=truncated

# --- diagnostics --------------------------------------------------------------
# trace | debug | info (default) | warn | error
NP_LOG_LEVEL=info

# --- optional integrations ----------------------------------------------------
# The Discord bot token. Prefer Admin -> Discord in the GUI, which encrypts it at rest with the
# installation key; an environment variable is readable by anything that can inspect the container.
NP_DISCORD_TOKEN=

# Path to an ffmpeg binary, if not the one on PATH. Without ffmpeg the hub still runs and still
# downloads; only format conversion becomes unavailable, and the API says so.
NP_FFMPEG_PATH=

# A directory of freely-licensed audio to expose as the "public domain" provider. Used by the test
# fixtures; leave empty for a normal install.
NP_PUBLIC_DOMAIN_DIR=
