{
  "name": "@now-playing/contracts",
  "version": "1.0.0",
  "description": "Canonical Zod schemas, API route contracts, realtime envelopes and file formats for the Now Playing suite. JSON Schema and OpenAPI are generated from this package.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/openapi.json": "./generated/openapi.json"
  },
  "files": [
    "src",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run --project contracts"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
