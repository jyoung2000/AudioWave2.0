{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetuneConfig",
  "type": "object",
  "properties": {
    "referenceHz": {
      "default": 440,
      "description": "A4 reference frequency",
      "type": "number",
      "minimum": 400,
      "maximum": 480
    },
    "pitchOffsetCents": {
      "default": 0,
      "description": "Additional manual offset",
      "type": "number",
      "minimum": -1200,
      "maximum": 1200
    },
    "mode": {
      "default": "off",
      "type": "string",
      "enum": [
        "off",
        "preserve-tempo",
        "linked-speed"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    }
  },
  "required": [
    "referenceHz",
    "pitchOffsetCents",
    "mode",
    "updatedAt"
  ],
  "additionalProperties": false
}
