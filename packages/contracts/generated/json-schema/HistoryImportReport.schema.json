{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryImportReport",
  "type": "object",
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "totalRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Duplicates by event_id"
    },
    "errors": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "row",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "sanitizedCells": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Cells whose spreadsheet-formula prefix was neutralised"
    }
  },
  "required": [
    "dryRun",
    "totalRows",
    "accepted",
    "skipped",
    "errors",
    "sanitizedCells"
  ],
  "additionalProperties": false
}
