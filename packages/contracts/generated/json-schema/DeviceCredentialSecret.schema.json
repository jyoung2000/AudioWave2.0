{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceCredentialSecret",
  "type": "object",
  "properties": {
    "credentialId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "hubId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "hubName": {
      "type": "string"
    },
    "hubFingerprint": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "description": "HTTPS (or loopback HTTP) base URL of the hub"
    },
    "secret": {
      "type": "string",
      "minLength": 32
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "library:read",
          "library:share",
          "playlists:sync",
          "eq:sync",
          "history:aggregate",
          "history:events",
          "group:member",
          "group:admin",
          "downloads:request",
          "transfers:receive",
          "files:serve",
          "search:use"
        ]
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    }
  },
  "required": [
    "credentialId",
    "deviceId",
    "hubId",
    "hubName",
    "hubFingerprint",
    "endpoint",
    "secret",
    "scopes",
    "issuedAt"
  ],
  "additionalProperties": false
}
