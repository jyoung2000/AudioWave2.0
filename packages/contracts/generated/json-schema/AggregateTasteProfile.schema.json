{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AggregateTasteProfile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "ownerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Device id or hub user id"
    },
    "computedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    },
    "windowDays": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sampleSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Number of meaningful listens in the window"
    },
    "minSampleMet": {
      "type": "boolean"
    },
    "artists": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "key",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "genres": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "key",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "albums": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "key",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "eras": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "key",
          "weight"
        ],
        "additionalProperties": false
      },
      "description": "Decade buckets like \"1990s\""
    },
    "discoveryRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "listeningPattern": {
      "minItems": 24,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Normalized hour-of-day histogram"
    },
    "sources": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "key",
          "weight"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "ownerId",
    "computedAt",
    "windowDays",
    "sampleSize",
    "minSampleMet",
    "artists",
    "genres",
    "albums",
    "eras",
    "discoveryRate",
    "listeningPattern",
    "sources"
  ],
  "additionalProperties": false
}
