{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrackIdentity",
  "type": "object",
  "properties": {
    "contentHash": {
      "default": null,
      "description": "SHA-256 of the file bytes when known",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lower-case hex SHA-256"
        },
        {
          "type": "null"
        }
      ]
    },
    "quickHash": {
      "default": null,
      "description": "Fast size+head+tail hash while full hash pending",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "isrc": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "musicbrainzRecordingId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "musicbrainzReleaseId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "acoustidId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "providerIds": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,31}$",
        "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  },
  "required": [
    "contentHash",
    "quickHash",
    "isrc",
    "musicbrainzRecordingId",
    "musicbrainzReleaseId",
    "acoustidId",
    "providerIds"
  ],
  "additionalProperties": false
}
