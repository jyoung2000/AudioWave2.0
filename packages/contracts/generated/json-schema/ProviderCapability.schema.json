{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCapability",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "search": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "preview": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "playback": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "importLikes": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "importPlaylists": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "creatorDownload": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "userOwnedDownload": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "groupSync": {
          "type": "string",
          "enum": [
            "exact",
            "near",
            "best_effort",
            "unsupported"
          ]
        },
        "eq": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "reason": {
          "description": "Human-readable explanation for \"Why unavailable?\"",
          "type": "string",
          "maxLength": 400
        }
      },
      "required": [
        "metadata",
        "search",
        "preview",
        "playback",
        "importLikes",
        "importPlaylists",
        "creatorDownload",
        "userOwnedDownload",
        "groupSync",
        "eq"
      ],
      "additionalProperties": false
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "provider",
    "capabilities",
    "reviewedAt"
  ],
  "additionalProperties": false
}
