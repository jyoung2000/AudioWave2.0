{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    },
    "deletedAt": {
      "default": null,
      "description": "Tombstone; retained per compaction policy",
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "artistId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "UUID (v7 preferred; stable across sync)"
        },
        {
          "type": "null"
        }
      ]
    },
    "artistName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "albumId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "UUID (v7 preferred; stable across sync)"
        },
        {
          "type": "null"
        }
      ]
    },
    "albumName": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "albumArtistName": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "discNumber": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "trackNumber": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "genre": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "genres": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "year": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3000
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Duration in milliseconds"
        },
        {
          "type": "null"
        }
      ]
    },
    "bpm": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "contentHash": {
          "default": null,
          "description": "SHA-256 of the file bytes when known",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Lower-case hex SHA-256"
            },
            {
              "type": "null"
            }
          ]
        },
        "quickHash": {
          "default": null,
          "description": "Fast size+head+tail hash while full hash pending",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "isrc": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "musicbrainzRecordingId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "musicbrainzReleaseId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "acoustidId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "providerIds": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$",
            "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "required": [
        "contentHash",
        "quickHash",
        "isrc",
        "musicbrainzRecordingId",
        "musicbrainzReleaseId",
        "acoustidId",
        "providerIds"
      ],
      "additionalProperties": false
    },
    "locators": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "browser-handle"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "handleId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "handleId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "opfs"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "objectId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "objectId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "windows-file"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "fileId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "fileId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "hub-blob"
              },
              "hubId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "blobId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "hubId",
              "blobId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "provider"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$",
                "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
              },
              "providerTrackId": {
                "type": "string",
                "minLength": 1
              },
              "canonicalUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "kind",
              "provider",
              "providerTrackId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "artworkId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "maxLength": 20
            },
            "codec": {
              "type": "string",
              "maxLength": 40
            },
            "mime": {
              "type": "string",
              "maxLength": 80
            },
            "sampleRateHz": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "bitrateKbps": {
              "type": "number",
              "minimum": 0
            },
            "channels": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "lossless": {
              "type": "boolean"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rootId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "UUID (v7 preferred; stable across sync)"
        },
        {
          "type": "null"
        }
      ]
    },
    "unsupportedReason": {
      "default": null,
      "description": "Set when the browser cannot decode this format",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "liked": {
      "default": false,
      "type": "boolean"
    },
    "explicit": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "popularity": {
      "default": null,
      "description": "Normalized provider popularity when known",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "deletedAt",
    "title",
    "artistId",
    "artistName",
    "albumId",
    "albumName",
    "albumArtistName",
    "discNumber",
    "trackNumber",
    "genre",
    "genres",
    "tags",
    "year",
    "durationMs",
    "bpm",
    "identity",
    "locators",
    "artworkId",
    "format",
    "rootId",
    "unsupportedReason",
    "liked",
    "explicit",
    "popularity"
  ],
  "additionalProperties": false
}
