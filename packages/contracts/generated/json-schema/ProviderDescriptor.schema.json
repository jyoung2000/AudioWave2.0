{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderDescriptor",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
    },
    "displayName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "audio-source",
        "metadata-only",
        "library",
        "tool"
      ]
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "authType": {
      "type": "string",
      "enum": [
        "none",
        "api-key",
        "oauth-pkce",
        "oauth-client-credentials",
        "device-credential",
        "local"
      ]
    },
    "authScopes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attribution": {
      "type": "string"
    },
    "rateStrategy": {
      "type": "string"
    },
    "cachePolicy": {
      "type": "string"
    },
    "groupCompatible": {
      "type": "boolean"
    },
    "discordCompatible": {
      "type": "boolean"
    },
    "reviewedAt": {
      "type": "string"
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "search": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "preview": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "playback": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "importLikes": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "importPlaylists": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "creatorDownload": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "userOwnedDownload": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "groupSync": {
          "type": "string",
          "enum": [
            "exact",
            "near",
            "best_effort",
            "unsupported"
          ]
        },
        "eq": {
          "type": "string",
          "enum": [
            "available",
            "requires_auth",
            "restricted",
            "unsupported",
            "temporarily_unavailable"
          ]
        },
        "reason": {
          "description": "Human-readable explanation for \"Why unavailable?\"",
          "type": "string",
          "maxLength": 400
        }
      },
      "required": [
        "metadata",
        "search",
        "preview",
        "playback",
        "importLikes",
        "importPlaylists",
        "creatorDownload",
        "userOwnedDownload",
        "groupSync",
        "eq"
      ],
      "additionalProperties": false
    },
    "enabled": {
      "type": "boolean"
    },
    "configured": {
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "displayName",
    "role",
    "authType",
    "authScopes",
    "groupCompatible",
    "discordCompatible",
    "reviewedAt",
    "limitations",
    "capabilities",
    "enabled",
    "configured"
  ],
  "additionalProperties": false
}
