{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharePayload",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "track",
        "album",
        "playlist",
        "library"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownerDisplayName": {
      "type": "string"
    },
    "artworkUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "UUID (v7 preferred; stable across sync)"
          },
          "title": {
            "type": "string"
          },
          "artistName": {
            "type": "string"
          },
          "albumName": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "artworkUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "streamable": {
            "type": "boolean"
          },
          "downloadable": {
            "type": "boolean"
          },
          "openAtSourceUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "availabilityNote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "trackId",
          "title",
          "artistName",
          "albumName",
          "durationMs",
          "artworkUrl",
          "streamable",
          "downloadable",
          "openAtSourceUrl",
          "availabilityNote"
        ],
        "additionalProperties": false
      }
    },
    "totalItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowStream": {
      "type": "boolean"
    },
    "allowDownload": {
      "type": "boolean"
    },
    "hubName": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "title",
    "description",
    "ownerDisplayName",
    "artworkUrl",
    "items",
    "totalItems",
    "expiresAt",
    "allowStream",
    "allowDownload",
    "hubName"
  ],
  "additionalProperties": false
}
