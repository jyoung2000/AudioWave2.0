{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrackRef",
  "type": "object",
  "properties": {
    "trackId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUID (v7 preferred; stable across sync)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "artistName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "albumName": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Duration in milliseconds"
        },
        {
          "type": "null"
        }
      ]
    },
    "artworkId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "contentHash": {
          "default": null,
          "description": "SHA-256 of the file bytes when known",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Lower-case hex SHA-256"
            },
            {
              "type": "null"
            }
          ]
        },
        "quickHash": {
          "default": null,
          "description": "Fast size+head+tail hash while full hash pending",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "isrc": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "musicbrainzRecordingId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "musicbrainzReleaseId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "acoustidId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "providerIds": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$",
            "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "required": [
        "contentHash",
        "quickHash",
        "isrc",
        "musicbrainzRecordingId",
        "musicbrainzReleaseId",
        "acoustidId",
        "providerIds"
      ],
      "additionalProperties": false
    },
    "locators": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "browser-handle"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "handleId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "handleId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "opfs"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "objectId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "objectId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "windows-file"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "fileId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "deviceId",
              "fileId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "hub-blob"
              },
              "hubId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "UUID (v7 preferred; stable across sync)"
              },
              "blobId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "hubId",
              "blobId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "provider"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$",
                "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
              },
              "providerTrackId": {
                "type": "string",
                "minLength": 1
              },
              "canonicalUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "kind",
              "provider",
              "providerTrackId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "provider": {
      "default": "local",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Provider slug, e.g. local, hub, companion, musicbrainz, youtube, soundcloud, bandcamp, spotify, public-domain, external-tool"
    },
    "genre": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "year": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "trackId",
    "title",
    "artistName",
    "albumName",
    "durationMs",
    "artworkId",
    "identity",
    "locators",
    "provider",
    "genre",
    "year"
  ],
  "additionalProperties": false
}
