{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscordStatus",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "configured": {
      "type": "boolean"
    },
    "gateway": {
      "type": "string",
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "reconnecting",
        "error",
        "stopped"
      ]
    },
    "voice": {
      "type": "string",
      "enum": [
        "idle",
        "connecting",
        "connected",
        "playing",
        "paused",
        "error"
      ]
    },
    "commandsRegistered": {
      "type": "boolean"
    },
    "commandsRegisteredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
        },
        {
          "type": "null"
        }
      ]
    },
    "messageContentIntent": {
      "type": "string",
      "enum": [
        "unknown",
        "enabled",
        "disabled"
      ]
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reconnects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptimeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "currentGuildId": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentVoiceChannelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentTrackTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "configured",
    "gateway",
    "voice",
    "commandsRegistered",
    "commandsRegisteredAt",
    "messageContentIntent",
    "latencyMs",
    "reconnects",
    "errors",
    "uptimeSeconds",
    "currentGuildId",
    "currentVoiceChannelId",
    "currentTrackTitle",
    "lastError",
    "warnings"
  ],
  "additionalProperties": false
}
