{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseMetadata",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "const": "windows-companion"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "UTC ISO-8601 timestamp with offset, e.g. 2026-09-03T12:00:00.000Z"
    },
    "channel": {
      "default": "stable",
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "dev"
      ]
    },
    "signed": {
      "type": "boolean",
      "description": "True only when the artifacts were code-signed in CI"
    },
    "minimumWindows": {
      "default": "Windows 10 1809+",
      "type": "string"
    },
    "notesUrl": {
      "type": "string",
      "format": "uri"
    },
    "artifacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "installer",
              "portable",
              "checksums"
            ]
          },
          "arch": {
            "type": "string",
            "enum": [
              "x64",
              "arm64"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Lower-case hex SHA-256"
          }
        },
        "required": [
          "kind",
          "arch",
          "filename",
          "url",
          "sizeBytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "version",
    "releasedAt",
    "channel",
    "signed",
    "minimumWindows",
    "artifacts"
  ],
  "additionalProperties": false
}
