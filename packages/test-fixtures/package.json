{
  "name": "@now-playing/test-fixtures",
  "version": "1.0.0",
  "description": "Deterministic, redistributable test fixtures: generated tone audio files with real tags, a sample library, provider/Discord protocol fixtures, listening-event streams and CSV samples.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "tsx scripts/generate-audio.ts",
    "test": "vitest run --project unit"
  },
  "dependencies": {
    "@now-playing/contracts": "workspace:*",
    "@now-playing/domain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
