{
  "name": "@now-playing/music-player",
  "version": "0.1.0",
  "description": "Now Playing Player \u2014 offline-first standalone PWA for local music playback with optional hub and companion connections.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:a11y": "playwright test --config tests/e2e/playwright.config.ts --grep @a11y",
    "test:visual": "playwright test --config tests/e2e/playwright.config.ts --grep @visual",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@now-playing/aqua-ui": "workspace:*",
    "@now-playing/audio-core": "workspace:*",
    "@now-playing/contracts": "workspace:*",
    "@now-playing/domain": "workspace:*",
    "@now-playing/recommendations": "workspace:*",
    "idb": "8.0.3",
    "music-metadata": "11.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@now-playing/test-fixtures": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
