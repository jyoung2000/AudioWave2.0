<?xml version="1.0" encoding="utf-8"?>
<!--
  What this app asks for, and what it deliberately does not.

  There is no storage permission. Music the app fetches lands in its own private directory and gets
  into the library through the player, which is the same path a file picked on a desktop takes; a
  request to read the whole device would buy nothing this needs.

  There is no cleartext traffic. The player is served from a real https origin inside the app, and
  the tools are told to fetch over https only, so allowing http would only widen what a mistake
  could reach.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- A fetch can outlast the moment someone switches away from the app. Without this Android is
       entitled to stop the work half-done, which is a bad way to lose ten minutes of downloading. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.NowPlaying"
    android:usesCleartextTraffic="false">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:label="@string/app_name"
      android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <service
      android:name=".FetchService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

  </application>
</manifest>
