{
  "name": "@now-playing/local-helper",
  "version": "1.0.0",
  "description": "Now Playing local helper — one small program that serves the player on loopback and runs yt-dlp or spotDL for it, so a browser page can do something a browser page cannot do alone. No container, no desktop app.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "now-playing-helper": "./dist/now-playing-helper.mjs"
  },
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/now-playing-helper.mjs",
    "test": "vitest run --project unit --project integration"
  },
  "dependencies": {
    "@now-playing/contracts": "workspace:*",
    "@now-playing/domain": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
