    {
      "product": "player",
      "kind": "view-union",
      "file": "music-player/src/App.tsx",
      "type": "ViewId",
      "prefix": "player-"
    },
    {
      "product": "hub",
      "kind": "view-union",
      "file": "docker-container/src/web/App.tsx",
      "type": "ViewId",
      "prefix": "hub-"
    },
    {
      "product": "companion",
      "kind": "view-union",
      "file": "windows-companion/src/renderer/App.tsx",
      "type": "ViewId",
      "prefix": "companion-"
    },
    {
      "product": "player",
      "kind": "files",
      "dir": "music-player/src/components",
      "suffix": "Sheet.tsx",
      "prefix": "player-sheet-"
    },
    {
      "product": "discord",
      "kind": "discord-commands",
      "file": "docker-container/src/discord/gateway.ts",
      "surface": "discord-replies"
    },
    {
      "product": "discord",
      "kind": "discord-templates",
      "file": "packages/contracts/src/entities/discord.ts",
      "surface": "discord-replies"
    }
  ],
