{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "player",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@now-playing/music-player",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "hub-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@now-playing/hub",
        "exec",
        "vite",
        "--config",
        "src/web/vite.config.ts"
      ],
      "port": 5174,
      "autoPort": true
    }
  ]
}
